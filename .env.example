# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# ---- Domain serving both paths: must match the server_name of the nginx
# vhost that includes nginx/searxng-mcp.conf
MCP_DOMAIN=example.com

# Public URL of the SearXNG web UI (as users reach it through nginx).
# The /searxng path must match the location in nginx/searxng-mcp.conf.
SEARXNG_BASE_URL=https://example.com/searxng

# ---- Secrets
SEARXNG_SECRET=replace-with-openssl-rand-hex-32
MCP_AUTH_TOKEN=replace-with-openssl-rand-hex-32

# ---- ProtonVPN egress (searxng + mcp-searxng go out only through the tunnel)
# PrivateKey of a WireGuard config from account.proton.me → VPN → WireGuard
# (any server; the key works for all of them)
PROTON_WG_PRIVATE_KEY=replace-with-wireguard-private-key
VPN_COUNTRIES=Switzerland   # comma-separated exit countries

# ---- Published ports (point your host nginx at these)
BIND_ADDRESS=127.0.0.1      # keep loopback so only host nginx can reach them
SEARXNG_PORT=8080
MCP_PORT=3000

# ---- Image versions (pin these for reproducible deploys)
SEARXNG_VERSION=latest
MCP_SEARXNG_VERSION=latest

# ---- mcp-searxng tuning
MCP_DEFAULT_LANGUAGE=all
MCP_MAX_RESULTS=10
MCP_MAX_RESULT_CHARS=500
MCP_RATE_INIT_MAX=20
MCP_RATE_SESSION_MAX=300

# Host headers mcp-searxng accepts (hardened mode). Defaults to
# MCP_DOMAIN plus the two loopback entries. Set this when the same
# vhost is reachable under more than one name (e.g. an additional
# IPv4 hostname or IP):
# MCP_HTTP_ALLOWED_HOSTS=example.com,proxy.example.com,127.0.0.1:3000,localhost:3000
